<UserControl x:Class="JaebeMusicStudio3.Front.Controls.Number"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <TextBox VerticalAlignment="Top" Name="Box" TextChanged="Box_OnTextChanged"></TextBox>
        <Slider VerticalAlignment="Top" Name="Slider" Margin="0,60,0,0" ValueChanged="Slider_OnValueChanged"></Slider>
    </Grid>
</UserControl>
