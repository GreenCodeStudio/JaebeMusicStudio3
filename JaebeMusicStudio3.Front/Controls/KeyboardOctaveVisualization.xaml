<UserControl x:Class="JaebeMusicStudio3.Front.Controls.KeyboardOctaveVisualization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N0"></Rectangle>
        <Rectangle Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N2"></Rectangle>
        <Rectangle Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N4"></Rectangle>
        <Rectangle Grid.Column="6" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N5"></Rectangle>
        <Rectangle Grid.Column="8" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N7"></Rectangle>
        <Rectangle Grid.Column="10" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N9"></Rectangle>
        <Rectangle Grid.Column="12" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" Stroke="Black" Name="N11"></Rectangle>
        <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Stroke="White" Fill="Black" Name="N1"></Rectangle>
        <Rectangle Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="0" Stroke="White" Fill="Black" Name="N3"></Rectangle>
        <Rectangle Grid.Column="7" Grid.ColumnSpan="2" Grid.Row="0" Stroke="White" Fill="Black" Name="N6"></Rectangle>
        <Rectangle Grid.Column="9" Grid.ColumnSpan="2" Grid.Row="0" Stroke="White" Fill="Black" Name="N8"></Rectangle>
        <Rectangle Grid.Column="11" Grid.ColumnSpan="2" Grid.Row="0" Stroke="White" Fill="Black" Name="N10"></Rectangle>
    </Grid>
</UserControl>
