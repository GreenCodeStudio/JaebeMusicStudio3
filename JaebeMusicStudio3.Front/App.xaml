<Application x:Class="JaebeMusicStudio3.Front.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front"
             xmlns:controls="clr-namespace:JaebeMusicStudio3.Front.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10 6" />
            <Setter Property="Margin" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#bbb" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6 4" />
            <Setter Property="Margin" Value="4" />

        </Style>

        <Style TargetType="{x:Type controls:LabeledControl2}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:LabeledControl2}">
                        <StackPanel>
                            <Label Content="{TemplateBinding Header}" />
                            <ContentPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>

</Application>