<UserControl x:Class="JaebeMusicStudio3.Front.Welcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <ScrollViewer>
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label HorizontalContentAlignment="Center" FontSize="40">Jaebe Music Studio</Label>
                <Label HorizontalContentAlignment="Center">The best open source DAW</Label>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
