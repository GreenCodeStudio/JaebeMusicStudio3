<UserControl x:Class="JaebeMusicStudio3.Front.MixerGui.SoundAnalyzer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.MixerGui"
                xmlns:controls="clr-namespace:JaebeMusicStudio3.Front.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Canvas Name="OsciloscopeCanvas" Grid.Row="0"></Canvas>
        <StackPanel Grid.Row="1" Background="Aqua" Orientation="Horizontal" >
            <RadioButton Name="OsciloscopeRadio" GroupName="type">Osciloscope</RadioButton>
            <RadioButton Name="FttRadio" GroupName="type">FTT</RadioButton>
            <controls:Number Width="200" x:Name="VerticalSize" Min="0" Max="10" sliderStyle="Linear"></controls:Number> 
            <controls:Number Width="200" x:Name="HorizontalSize" Min="1" Max="20000" Value="100" sliderStyle="Logarithmic"></controls:Number> 
        </StackPanel>
    </Grid>
</UserControl>