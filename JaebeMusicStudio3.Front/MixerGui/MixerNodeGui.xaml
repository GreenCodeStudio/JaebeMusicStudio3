<UserControl x:Class="JaebeMusicStudio3.Front.MixerGui.MixerNodeGui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.MixerGui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="#8bb">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Label Name="Title"  Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">Mixer node</Label>
        <StackPanel Name="Inputs" Background="#add" Grid.Column="0" Grid.Row="1"></StackPanel>
        <StackPanel Name="Outputs" Background="#add" Grid.Column="1" Grid.Row="1"></StackPanel>
    </Grid>
</UserControl>
