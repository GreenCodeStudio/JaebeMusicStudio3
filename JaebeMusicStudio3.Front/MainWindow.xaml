        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JaebeMusicStudio3.Front"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid  Background="#ddd">
        <StackPanel>

            <ComboBox VerticalAlignment="Top" Name="OutputSelect"></ComboBox>
            <ComboBox VerticalAlignment="Top" Name="QualitySelect"></ComboBox>
            <Grid x:Name="Tabs"></Grid>
        </StackPanel>
    </Grid>
</Window>