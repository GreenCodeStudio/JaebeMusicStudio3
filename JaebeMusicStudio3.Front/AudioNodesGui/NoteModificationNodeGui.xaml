<UserControl x:Class="JaebeMusicStudio3.Front.AudioNodesGui.NoteModificationNodeGui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.AudioNodesGui"
             xmlns:controls="clr-namespace:JaebeMusicStudio3.Front.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <StackPanel>
            <Slider Name="Octave" Minimum="-8" Maximum="8"></Slider>
            <Slider Name="Note" Minimum="-12" Maximum="12"></Slider>
            <Slider Name="SubNote" Minimum="-0.5" Maximum="0.5"></Slider>
        </StackPanel>
    </Grid>
</UserControl>
