<UserControl x:Class="JaebeMusicStudio3.Front.AudioNodesGui.OverdriveNodeGui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.AudioNodesGui"
             xmlns:controls="clr-namespace:JaebeMusicStudio3.Front.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <StackPanel>
            <controls:LabeledControl2 Header="Volume">
                <controls:VolumeSlider Max="10" x:Name="VolumeValueSlider"/>
            </controls:LabeledControl2>
            <controls:LabeledControl2 Header="Limit">
                <controls:VolumeSlider x:Name="LimitSlider"/>
            </controls:LabeledControl2>
        </StackPanel>
    </Grid>
</UserControl>