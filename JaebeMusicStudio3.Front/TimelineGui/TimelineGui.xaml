<UserControl x:Class="JaebeMusicStudio3.Front.TimelineGui.TimelineGui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.TimelineGui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Click="LoadFileClick">Load file</Button>
                <Button Click="AudioRecorderClick">Audio recorder</Button>
                <Button Click="NoteLineClick">Note line</Button>
                <Button Click="ZoomOut">Zoom -</Button>
                <Button Click="ZoomIn">Zoom +</Button>
                <Button Click="ZoomHOut">Zoom H -</Button>
                <Button Click="ZoomHIn">Zoom H +</Button>
                <Button Click="Play">Play</Button>
                <Button Click="Stop">Stop</Button>
            </StackPanel>
            <Grid Name="LinesWrapper" Grid.Row="1" ClipToBounds="True">
                <Rectangle Fill="Brown" Width="1" HorizontalAlignment="Left" Name="NowMarker"></Rectangle>
                <Grid Name="Lines" >
                </Grid>
                <local:TimelineMarker Height="30" x:Name="TimelineMarker" VerticalAlignment="Top" Background="#8fff" TimeClicked="TimelineMarker_OnTimeClicked" />
            </Grid>
            <ScrollBar Orientation="Horizontal" Scroll="ScrollBar_OnScroll" Name="HorizontalScrollBar" Grid.Row="2"></ScrollBar>
            <ScrollBar Orientation="Vertical" Scroll="ScrollBar_OnScroll" Name="VerticalScrollBar" Grid.Row="1" Grid.Column="1"></ScrollBar>
        </Grid>
    </Grid>
</UserControl>