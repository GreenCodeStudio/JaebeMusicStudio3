<UserControl x:Class="JaebeMusicStudio3.Front.TimelineGui.TimelineGui"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.TimelineGui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="White">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Click="LoadFileClick">Load file</Button>
                <Button Click="AudioRecorderClick">Audio recorder</Button>
                <Button Click="ZoomOut">Zoom -</Button>
                <Button Click="ZoomIn">Zoom +</Button>
                <Button Click="ZoomHOut">Zoom H -</Button>
                <Button Click="ZoomHIn">Zoom H +</Button>
                <Button Click="Play">Play</Button>
                <Button Click="Stop">Stop</Button>
            </StackPanel>
            <Grid Name="LinesWrapper">
                <Rectangle Fill="Brown" Width="1" HorizontalAlignment="Left" Name="NowMarker"></Rectangle>
                <StackPanel Name="Lines">
                <local:TimelineMarker Height="30" x:Name="TimelineMarker" />
                <Grid Name="NextLine" Background="AntiqueWhite" Height="100"></Grid>
            </StackPanel>
                </Grid>
            <ScrollBar Orientation="Horizontal" Scroll="ScrollBar_OnScroll" Name="HorizontalScrollBar"></ScrollBar>
        </StackPanel>
    </Grid>
</UserControl>