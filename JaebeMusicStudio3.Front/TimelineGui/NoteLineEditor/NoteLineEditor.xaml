<UserControl x:Class="JaebeMusicStudio3.Front.TimelineGui.NoteLineEditor.NoteLineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.TimelineGui.NoteLineEditor"
             xmlns:timelineGui="clr-namespace:JaebeMusicStudio3.Front.TimelineGui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Name="NoteEditorWrapper"></Grid>
        <StackPanel Background="#ddd" Name="PropertiesWrapper" Grid.Column="1" Margin="4" >
            <StackPanel>
                <ComboBox Name="InstrumentSelect"></ComboBox>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</UserControl>
