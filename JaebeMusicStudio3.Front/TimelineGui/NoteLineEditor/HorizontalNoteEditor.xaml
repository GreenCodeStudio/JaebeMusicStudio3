<UserControl x:Class="JaebeMusicStudio3.Front.TimelineGui.NoteLineEditor.HorizontalNoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaebeMusicStudio3.Front.TimelineGui.NoteLineEditor"
             xmlns:timelineGui="clr-namespace:JaebeMusicStudio3.Front.TimelineGui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Background="#eee" Name="Pitches" Grid.Column="0" Margin="4" />
        <timelineGui:TimelineMarkerBeats Grid.Column="1" Margin="4,30,4,4" x:Name="TimelineMarkerBeatsLines"
                                         Lines="True" Texts="True" VerticalAlignment="Stretch" Background="#8fff" />
        <Grid Name="NowMarkers" Grid.Column="1" Margin="4" />
        <Grid Name="Plane" Grid.Column="1" Background="#0002" Margin="4" />

        <timelineGui:TimelineMarker Grid.Column="1" Margin="4,0,4,0" Height="30" x:Name="TimelineMarker"
                                    VerticalAlignment="Top" Background="#8fff" />
        <timelineGui:TimelineMarkerBeats Grid.Column="1" Margin="4,30,4,0" Height="30" x:Name="TimelineMarkerBeats"
                                         VerticalAlignment="Top" Background="#8fff" />
        <ScrollBar Orientation="Horizontal" Scroll="ScrollBar_OnScroll" Name="HorizontalScrollBar" Grid.Column="1"
                   VerticalAlignment="Bottom" Grid.Row="2">
        </ScrollBar>
        <ScrollBar Orientation="Vertical" Scroll="ScrollBar_OnScroll" Name="VerticalScrollBar" Grid.Row="1"
                   Grid.Column="2" Minimum="-150" Maximum="-20">
        </ScrollBar>
    </Grid>
</UserControl>