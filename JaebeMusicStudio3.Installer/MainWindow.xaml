<Window x:Class="JaebeMusicStudio3.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JaebeMusicStudio3.Installer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ScrollViewer>
            <Grid>
                <StackPanel>
                    <Label HorizontalContentAlignment="Center">Jaebe Music Studio Installer</Label>
                    <StackPanel>
                        <TextBox Name="Path"></TextBox>
                    </StackPanel>
                    <Button Click="Install">Install</Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>